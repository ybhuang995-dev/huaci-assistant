# 划词助手 配置文件
# 复制此文件为 .env，然后填入你的 API Key
#   cp .env.example .env

# ── API 配置（必填）────────────────────────────────────
# DeepSeek API Key（获取地址：https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=your_key_here

# API 地址（DeepSeek 默认，OpenAI 兼容接口均可替换）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称（deepseek-v4-flash 或 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 窗口 ──────────────────────────────────────────────
WINDOW_WIDTH=800
WINDOW_HEIGHT=600

# ── 剪贴板轮询间隔（秒）───────────────────────────────
POLL_INTERVAL=0.4

# ── 默认模式 ───────────────────────────────────────────
# translate | ask | code | summarize | dict
DEFAULT_MODE=translate

# ── 字体 ──────────────────────────────────────────────
FONT=Microsoft YaHei UI

# ── 功能开关 ───────────────────────────────────────────
# 检测到单词自动切词典模式
AUTO_DICT=true
# 开机自启（通过注册表 Run 键）
AUTO_START=false
# 自动路由（LLM 自动判断文本类型并选择模式）
AUTO_ROUTE=true

# ── 选择提供商（DeepSeek / OpenAI 等）─────────────────
PROVIDER=DeepSeek

# ── 用户关注方向（可选）───────────────────────────────
# 为 AI 提供当前聚焦方向的上下文，留空则不注入额外提示
# 例如：USER_DIRECTION=我正在学习 Rust 编程
USER_DIRECTION=

# ── 模式启用开关（JSON）───────────────────────────────
# 取消勾选的模式不会出现在 LLM 自动路由的可选项中
MODE_ENABLED={"translate": true, "ask": true, "code": true, "summarize": true, "dict": true}

# ── 自定义模式 Prompt（JSON，仅保存与默认值不同的覆盖）───
# 正常使用通过设置面板编辑即可，无需手动修改此字段。
# 升级后若需切换到新默认 Prompt，请在设置面板中执行"恢复 Prompt 默认 → 保存"。
MODE_PROMPTS={}

# ── 自定义模式（JSON 数组）───────────────────────────
# 在设置面板的「模式 Prompt」中添加/删除自定义模式。
# 每个元素包含：key（标识符，唯一）、label（显示名称）、
#   system_prompt、classifier_desc（AI 自动识别描述）
# 最多支持 9 个模式（含内置的 5 个）。
# 示例：
# CUSTOM_MODES=[{"key":"search","label":"搜索","system_prompt":"你是一个搜索助手...","classifier_desc":"- search: 需要联网搜索的查询"}]

# ── 分类器描述覆盖（JSON，仅保存与默认值不同的覆盖）───
# 正常使用通过设置面板编辑即可。
MODE_CLASSIFIER_DESCS={}

# ── 剪贴板过滤器开关（JSON）─────────────────────────
# too_short=过短文本, numbers=纯数字, paths=文件路径, url=网址, filename=文件名
FILTERS={"too_short": true, "numbers": true, "paths": true, "url": true, "filename": true}

# ── 全局快捷键 ────────────────────────────────────────
HOTKEY_PAUSE=ctrl+p

# ── 历史记录 ───────────────────────────────────────────
SAVE_HISTORY=true
# 对话链节点数达到此值后才在历史中显示（默认 3）
HISTORY_MIN_NODES=3
