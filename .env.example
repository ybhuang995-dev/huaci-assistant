# 划词助手 配置文件
# 复制此文件为 .env，然后填入你的 API Key
#   cp .env.example .env

# ── API 配置（必填）────────────────────────────────────
# DeepSeek API Key（获取地址：https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=your_key_here

# API 地址（DeepSeek 默认，OpenAI 兼容接口均可替换）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称（deepseek-v4-flash 或 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 窗口 ──────────────────────────────────────────────
WINDOW_WIDTH=800
WINDOW_HEIGHT=600

# ── 剪贴板轮询间隔（秒）───────────────────────────────
POLL_INTERVAL=0.4

# ── 默认模式 ───────────────────────────────────────────
# translate | ask | code | summarize | dict
DEFAULT_MODE=translate

# ── 字体 ──────────────────────────────────────────────
FONT=Microsoft YaHei UI

# ── 功能开关 ───────────────────────────────────────────
# 检测到单词自动切词典模式
AUTO_DICT=true
# 开机自启（通过注册表 Run 键）
AUTO_START=false
# 自动路由（LLM 自动判断文本类型并选择模式）
AUTO_ROUTE=true

# ── 选择提供商（DeepSeek / OpenAI 等）─────────────────
PROVIDER=DeepSeek

# ── 用户关注方向（可选）───────────────────────────────
# 为 AI 提供当前聚焦方向的上下文，留空则不注入额外提示
# 例如：USER_DIRECTION=我正在学习 Rust 编程
USER_DIRECTION=

# ── 模式启用开关（JSON）───────────────────────────────
# 取消勾选的模式不会出现在 LLM 自动路由的可选项中
MODE_ENABLED={"translate": true, "ask": true, "code": true, "summarize": true, "dict": true}

# ── 自定义模式 Prompt（JSON）─────────────────────────
# 可在设置面板中编辑，此处为默认值
MODE_PROMPTS={"translate": "你是一个专业的翻译助手。请将用户输入的文本翻译成中文。如果输入已经是中文，则翻译成英文。保持原文的格式、语气和风格。只返回翻译结果，不要添加任何解释。", "ask": "你是一个知识渊博的 AI 助手。根据用户选中的文本提供清晰、准确的回答。\n- 如果文本是一个问题，直接回答。\n- 如果文本是一个概念或术语，给出简明解释。\n- 如果文本是一段内容，给出分析或总结。\n请用中文回答。", "code": "你是一个专业的代码助手。请对用户提供的代码进行全面分析。\n\n**分析要点：**\n- 简要说明代码的整体功能和用途\n- 逐段解释核心逻辑和关键实现细节\n- 指出潜在的 bug、边界条件问题或安全隐患\n- 提出性能优化或代码结构改进建议\n- 如果用户明确要求，可以重构或改写代码\n\n**格式要求：**\n- 使用 Markdown 排版，代码块标记正确的语言类型\n- 对比代码用 diff 格式标注变更\n- 复杂度较高的逻辑可配图表或伪代码辅助说明\n\n请用中文回答，代码标识符和注释保持原文语言。", "summarize": "你是一个内容总结助手。请用简洁的要点总结以下内容的核心信息。\n- 用无序列表（- ）列出 3-5 个关键要点。\n- 每个要点不超过一句话。\n- 保留原文中的重要数据和专有名词。\n请用中文输出。", "dict": "你是一个专业的英语词典。请对用户输入的单词给出详细解释。\n\n**格式要求**（用 Markdown）：\n- 音标：英式 /ˈxxx/　美式 /ˈxxx/\n- 词性：名词 / 动词 / 形容词 等\n- 主要释义（含中文翻译），按常用度排列\n- 2-3 个英文例句（带中文翻译）\n- 如有常见搭配或同义词，简要列出\n\n保持简洁清晰，适合快速查阅。"}

# ── 自定义模式（JSON 数组）───────────────────────────
# 在设置面板的「模式 Prompt」中添加/删除自定义模式。
# 每个元素包含：key（标识符，唯一）、label（显示名称）、
#   system_prompt、classifier_desc（AI 自动识别描述）
# 最多支持 9 个模式（含内置的 5 个）。
# 示例：
# CUSTOM_MODES=[{"key":"search","label":"搜索","system_prompt":"你是一个搜索助手...","classifier_desc":"- search: 需要联网搜索的查询"}]

# ── 分类器描述覆盖（JSON 对象）───────────────────────
# 覆盖内置模式的 AI 分类器描述。自定义模式的描述存在 CUSTOM_MODES 中。
# MODE_CLASSIFIER_DESCS={"translate":"- translate: 自定义翻译描述"}

# ── 剪贴板过滤器开关（JSON）─────────────────────────
# too_short=过短文本, numbers=纯数字, paths=文件路径, url=网址, filename=文件名
FILTERS={"too_short": true, "numbers": true, "paths": true, "url": true, "filename": true}

# ── 全局快捷键 ────────────────────────────────────────
HOTKEY_PAUSE=ctrl+p

# ── 历史记录 ───────────────────────────────────────────
SAVE_HISTORY=true
# 对话链节点数达到此值后才在历史中显示（默认 3）
HISTORY_MIN_NODES=3
